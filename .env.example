# =====================================================
# انسخ هذا الملف وأعد تسميته إلى ".env" ثم املأ القيم
# لا تشارك هذا الملف مع أي أحد أبداً بعد تعبئته!
# =====================================================

# التوكن الخاص بالبوت (من Discord Developer Portal)
DISCORD_TOKEN=ضع_التوكن_هنا

# معرف تطبيق البوت (Application ID / Client ID)
CLIENT_ID=ضع_معرف_التطبيق_هنا

# معرف السيرفر (اختياري - يستخدم لتسجيل الأوامر بسرعة أثناء التطوير)
# اتركه فارغاً إذا كنت تريد تسجيل الأوامر عالمياً (Global) لكل السيرفرات
GUILD_ID=
