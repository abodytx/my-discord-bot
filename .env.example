# =====================================================
# انسخ هذا الملف وأعد تسميته إلى ".env" ثم املأ القيم
# لا تشارك هذا الملف مع أي أحد أبداً بعد تعبئته!
# =====================================================

# التوكن الخاص بالبوت (من Discord Developer Portal)
DISCORD_TOKEN=ضع_التوكن_هنا

# معرف تطبيق البوت (Application ID / Client ID)
CLIENT_ID=ضع_معرف_التطبيق_هنا

# معرف السيرفر (اختياري - يستخدم لتسجيل الأوامر بسرعة أثناء التطوير)
# اتركه فارغاً إذا كنت تريد تسجيل الأوامر عالمياً (Global) لكل السيرفرات
GUILD_ID=

# =====================================================
# إعدادات لوحة التحكم (Web Dashboard)
# =====================================================

# منفذ تشغيل لوحة التحكم
PORT=3000

# كلمة مرور الدخول للوحة التحكم (مهم جداً - غيّرها!)
DASHBOARD_PASSWORD=ضع_كلمة_مرور_قوية_هنا

# سر التشفير لجلسة الدخول (اختياري - يُنشأ تلقائياً إن تُرك فارغاً)
DASHBOARD_SECRET=

# =====================================================
# إعدادات الموسيقى (YouTube)
# =====================================================

# كوكيز يوتيوب (مهم جداً! يوتيوب يطلب تسجيل دخول للبث مؤخراً)
# طريقة الحصول عليها: افتح يوتيوب في المتصفح وسجل دخول بحساب احتياطي،
# ثم من أدوات المطور (F12) → Application → Cookies انسخ قيمة SID و HSID و SSID
# والصقها بالشكل: SID=...; HSID=...; SSID=...
# المرجع الكامل: https://ytjs.dev/guide/authentication.html#cookies
YOUTUBE_COOKIE=
